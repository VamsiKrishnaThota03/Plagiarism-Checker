# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# true only for local development
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Google Custom Search JSON API (needed for the web check only)
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CSE_ID=your-programmable-search-engine-id
# API calls per check (free tier: 100/day)
MAX_SEARCH_QUERIES=25

# Input limits
MAX_TEXT_CHARS=20000
MAX_UPLOAD_BYTES=5242880

# Production hardening. All default to the secure value; override only when the
# deployment genuinely needs it (for example a plain-HTTP host).
# Enabling HSTS is effectively irreversible for the length of max-age.
DJANGO_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# Left false on purpose: browser preload submission is permanent.
DJANGO_HSTS_PRELOAD=false
